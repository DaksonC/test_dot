# Copie para .env (na pasta da questão ou na raiz) e preencha. Nunca versione o .env.

# --- Q1: API de livros (opcional) ---
# Padrão: sqlite:///./library.db
DATABASE_URL=

# --- Q2: Chatbot (obrigatório) ---
OPENAI_API_KEY=
# Modelo usado pelo chatbot (opcional; padrão: gpt-5.6-luna)
OPENAI_MODEL=
# Temperatura (opcional, 0 a 2; vazio = padrão do modelo)
OPENAI_TEMPERATURE=
# Quantas mensagens do histórico enviar ao modelo (opcional; padrão: 20)
CHAT_MAX_HISTORY_MESSAGES=

# --- Q2: Tracing no LangSmith (opcional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
